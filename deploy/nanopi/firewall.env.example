# Robot firewall site configuration. Copy to firewall.env and edit.
# setup_nanopi.sh renders the nftables/netplan/sysctl templates from this file
# and installs it as /etc/robot_firewall/firewall.env for the systemd service.

# Interfaces on the gateway (check with `ip -br link`; USB WiFi is often wlx<mac>).
WIFI_IF=wlan0
ROBOT_IF=eth0

# Laptop on the WiFi side. Give it a fixed IP / DHCP reservation: only this
# address may reach the gateway (SSH + ROS domain UNTRUSTED_DOMAIN).
LAPTOP_IP=192.168.1.50

# Isolated robot LAN on the Ethernet cable.
GATEWAY_ROBOT_IP=192.168.50.1
ROBOT_IP=192.168.50.2
ROBOT_PREFIX=24

# ROS 2 domains. Must differ. The laptop uses UNTRUSTED_DOMAIN, the robot TRUSTED_DOMAIN.
UNTRUSTED_DOMAIN=10
TRUSTED_DOMAIN=20

# Gateway implementation: rust (default; drops unauthorized publishers per
# message) or python (monitor_py firewall_node).
FIREWALL_IMPL=rust

# SROS2 enclave used by the gateway on the WiFi side ("" disables DDS-Security;
# not recommended outside the bench).
FIREWALL_ENCLAVE=/firewall

# WiFi network the gateway joins (only used with --with-netplan).
WIFI_SSID=YOUR_SSID

# SIEM export (Rust gateway): stream incidents, tagged with MITRE ATT&CK for
# ICS, to a syslog collector. Empty disables it. The nftables rules allow
# exactly this destination out of the WiFi interface.
SIEM_SYSLOG=
#SIEM_SYSLOG=udp://192.168.1.60:514
# cef (Splunk, Sentinel, QRadar, ArcSight) or json (Elastic). No inline
# comments on value lines: systemd's EnvironmentFile would keep them.
SIEM_FORMAT=cef
